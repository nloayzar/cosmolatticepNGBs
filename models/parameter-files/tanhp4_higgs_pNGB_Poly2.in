# Parameter file for tanhp4_higgs_pNGB_Poly2

# Output
outputfile = ./test_poly2/
print_headers = false
overwriteFiles = true

# Evolution
expansion = true
fixedBackground = false
evolver = RK2

# Lattice
N = 64
kIR = 0.25
dt = 0.001

# Times
tMax = 10
tOutputFreq = 1
tOutputInfreq = 2

# Spectra options
PS_type = 1
PS_version = 1
kCutOff = 100
baseSeed=1234

# Gravitational waves
withGWs = false

# Initial conditions
# Field order: phi h chi
initial_amplitudes = 4.80234e18 0.0 0.0
initial_momenta = -1.75455e31 0.0 0.0
ICtype_S = Default

# Optional external scalar power spectra
ext_PS0 = None
ext_PS1 = None
ext_PS2 = None

# Model parameters
M = 1.2175e19
Lambda4 = 5.47808e64
lambda = 1e-11
sigma = 1e-9
lambdah = 1e-9
masspNGB = 0.0

# Scalar derivative coupling
# Enabled coupling is (phi, chi), so this file expects one value.
# The value is available to model-defined derivativeCouplingFunction hooks.
# The current tanhp4_higgs_pNGB hooks intentionally throw until f(phi) and df/dphi are specified.
lambda_DerivativeCoupling = 1
