# Parameter file for tanhp2_higgs_pNGB_Poly2

# Output
outputfile = ./
print_headers = false
overwriteFiles = true

# Evolution
expansion = true
fixedBackground = false
evolver = RK2

# Lattice
N = 256
kIR = 0.25
dt = 0.001

# Times
tMax = 300
tOutputFreq = .1
tOutputInfreq = 2

# Spectra options
PS_type = 1
PS_version = 1
kCutOff = 100
baseSeed=1234

# Gravitational waves
withGWs = false

# Initial conditions
# Field order: phi h chi
initial_amplitudes = 2.32106e18 0.0 0.0
initial_momenta = -2.30234e-31 0.0 0.0
ICtype_S = Default

# Optional external scalar power spectra
ext_PS0 = None
ext_PS1 = None
ext_PS2 = None

# Model parameters
M = 1.2175e19 # in GeV
Lambda4 = 2.64752e64 # in GeV^4
lambda = 1e-7 # 
sigma = 1.1e8 # in GeV
lambdah = 6.77461e-11 # 
masspNGB = 0.0

# Scalar derivative coupling
# Enabled coupling is (phi, chi), so this file expects one value.
# The value is available to model-defined derivativeCouplingFunction hooks.
lambda_DerivativeCoupling = 0.2
