# Parameter file for tanhp4_higgs_pNGB

# Output
outputfile = ./
print_headers = true
overwriteFiles = false
appendToFiles = false

# Evolution
expansion = true
fixedBackground = false
evolver = RK2
a0 = 1

# Lattice
N = 64
kIR = 1
dt = 0.01

# Times
t0 = 0
tMax = 100
tOutputFreq = 1
tOutputInfreq = 10
tOutputRareFreq = 100
tOutputVerb = 10
tBackupFreq = -1

# Spectra options
PS_type = 1
PS_version = 1
spectraVerbosity = 1
deltaKBin = 1
saveUnbinnedSpectra = false
kCutOff = 2

# Gravitational waves
withGWs = false
doLFforGWs = true
GWprojectorType = 1

# Initial conditions
# Field order: phi h chi
initial_amplitudes =
initial_momenta =
ICtype_S = Default

# Optional external scalar power spectra
ext_PS0 = None
ext_PS1 = None
ext_PS2 = None

# Model parameters
M =
Lambda4 =
lambda =
sigma =
massh =
masspNGB =

# Scalar derivative coupling
# Enabled coupling is (phi, chi), so this file expects one value.
# Lambda = lambda_DerivativeCoupling * MPl / fStar.
lambda_DerivativeCoupling =
