# Parameter file for m2phi2_higgs_pNGB_Poly2

# Output
outputfile = ./test_m2phi2/
print_headers = false
overwriteFiles = true

# Evolution
expansion = true
fixedBackground = false
evolver = RK2

# Lattice
N = 64
kIR = 0.25
dt = 0.01

# Times
tMax = 40
tOutputFreq = .1
tOutputInfreq = 2

# Spectra options
PS_type = 1
PS_version = 1
kCutOff = 100
baseSeed=1234

# Gravitational waves
withGWs = false

# Initial conditions
# Field order: phi h chi
initial_amplitudes = 2.45297e18 0.0 0.0
initial_momenta = -2.46107e31 0.0 0.0
ICtype_S = Default

# Optional external scalar power spectra
ext_PS0 = None
ext_PS1 = None
ext_PS2 = None

# Model parameters
 mass = 1.41894e13
  lambda = 1e-15
  sigma = 8.20802e8 # in GeV (q3 = 10)
  lambdah = 1.0e-8
  masspNGB = 0.0
  


# Scalar derivative coupling
# Enabled coupling is (phi, chi), so this file expects one value.
# The value is available to model-defined derivativeCouplingFunction hooks.
lambda_DerivativeCoupling = 1000000
